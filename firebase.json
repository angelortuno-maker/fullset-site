{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "README.md", "**/.*", "**/node_modules/**", "action/**", "docs/**", "tools/**", "**/.git/**", ".git/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/privacy/", "destination": "/privacy", "type": 301 },
      { "source": "/terms/", "destination": "/terms", "type": 301 },
      { "source": "/support/", "destination": "/support", "type": 301 },
      { "source": "/coaches/", "destination": "/coaches", "type": 301 },
      { "source": "/privacy.html", "destination": "/privacy", "type": 301 },
      { "source": "/support.html", "destination": "/support", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "**/*.+([0-9a-f]).@(css|png|jpg|jpeg|gif|webp|avif|svg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
